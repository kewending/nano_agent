# ==============================================================================
# Model Provider Configuration
# ==============================================================================

# Option A: Google Gemini (OpenAI-compatible endpoint)
# GEMINI_API_KEY=AQ...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_CONTEXT_WINDOWS = 1_048_576

# Option B: Local llama.cpp server 
# LLAMA_API_KEY=not-needed
# LLAMA_BASE_URL=http://localhost:9931/v1
# LLAMA_MODEL=local-model
# LLAMA_CONTEXT_WINDOWS = 131_072

# ==============================================================================
# Agent Execution Settings
# ==============================================================================
MAX_ITERATIONS=10
